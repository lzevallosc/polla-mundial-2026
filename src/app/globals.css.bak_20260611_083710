@import "tailwindcss";

:root {
  --background: #020617;
  --foreground: #f8fafc;
}

body {
  background: radial-gradient(circle at top, #1e3a8a 0, #020617 38%, #020617 100%);
  color: var(--foreground);
  min-height: 100vh;
}

input,
select,
textarea {
  background: #ffffff !important;
  color: #020617 !important;
  border: 1px solid #cbd5e1;
}

input::placeholder,
textarea::placeholder {
  color: #64748b !important;
}
